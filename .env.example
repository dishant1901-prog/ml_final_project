# Copy to .env (never commit it) and run: chmod 600 .env
# Satellite access for new runs (Copernicus Data Space Ecosystem, Sentinel Hub OAuth client):
SH_CLIENT_ID=
SH_CLIENT_SECRET=
# Pre-event OpenStreetMap through the ohsome API v2:
OHSOME_API_KEY=
# Data folders (absolute paths):
HIMAROAD_DATA_DIR=/absolute/path/HimaRoad_flood-copilot/data
DATA_ROOT=/absolute/path/HimaRoad_flood-copilot/data/copilot
REPORT_FONT=/absolute/path/HimaRoad_flood-copilot/data/copilot/cache/fonts/NotoSansDevanagari.ttf
# Optional internal-showcase accounts. Generate these safely with:
#   .venv/bin/python scripts/configure_local_auth.py
# Never invent or paste password hashes by hand and never commit the generated values.
LOCAL_AUTH_ADMIN_USERNAME=
LOCAL_AUTH_ADMIN_PASSWORD_HASH=
LOCAL_AUTH_VIEWER_USERNAME=
LOCAL_AUTH_VIEWER_PASSWORD_HASH=
LOCAL_AUTH_COOKIE_SECRET=
LOCAL_SERVICE_TOKEN=
RATE_LIMIT_PER_MINUTE=600
MAX_QUEUED_JOBS=16
JOB_STALE_SECONDS=7200
